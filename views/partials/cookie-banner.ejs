<div
  class="cookie-banner"
  data-cookie-banner
  hidden
  role="dialog"
  aria-label="Cookie consent"
  data-i18n-aria-label="cookie.ariaLabel"
  aria-modal="false"
>
  <div class="cookie-banner-content">
    <p class="cookie-banner-text">
      <span data-i18n="cookie.messagePrefix">
        Taskify uses cookies, session storage, and local storage to keep your session active and remember your preferences.
        Read our
      </span>
      <a href="/privacy" class="cookie-banner-link" data-i18n="cookie.privacyLink">Privacy Policy</a><span data-i18n="cookie.messageSuffix">.</span>
    </p>
    <button type="button" class="cookie-banner-accept" data-cookie-accept data-i18n="cookie.accept">
      Accept
    </button>
  </div>
</div>
