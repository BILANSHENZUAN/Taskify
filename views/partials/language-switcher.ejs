<div
  class="language-switcher"
  role="group"
  aria-label="Language switcher"
  data-i18n-aria-label="common.languageSwitcher"
>
  <div class="language-switcher-controls">
    <button
      type="button"
      class="language-switcher-button"
      data-language-option="en"
      aria-pressed="true"
      aria-label="Switch to English"
      data-i18n-aria-label="common.switchToEnglish"
    >
      English
    </button>
    <button
      type="button"
      class="language-switcher-button"
      data-language-option="zh"
      aria-pressed="false"
      aria-label="切换到中文"
      data-i18n-aria-label="common.switchToChinese"
    >
      中文
    </button>
  </div>
</div>
