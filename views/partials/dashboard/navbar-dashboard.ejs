<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>
  <link rel="stylesheet" href="../../../static/styles/partials/dashboard/navbar-dashboard.css" />
  <link rel="stylesheet" href="../../../static/styles/main.css">


</head>

<body>
  <header class="dashboard-header-navbar">
    <div class="dashboard-navbar-container">
      <nav class="dashboard-navbar-dashboard-navbar">
          <form action="#" class="dashboard-navbar-search-bar" role="search">
            <label class="sr-only" for="dashboard-search" data-i18n="dashboard.searchLabel">Search projects</label>
            <button type="submit" aria-label="Submit search" data-i18n-aria-label="dashboard.searchButton">
              <i class="fas fa-search" aria-hidden="true"></i>
            </button>
            <input id="dashboard-search" type="text" placeholder="Search" data-i18n-placeholder="dashboard.searchPlaceholder" />
          </form>
        <div class="dashboard-navbar-dashboard-links">
          <ul class="dashboard-navbar-dashboard-navbar-links">
            <li>
              <a href="#" aria-label="Help" data-i18n-aria-label="dashboard.help"><i class="fa-regular fa-circle-question" aria-hidden="true"></i></a>
            </li>
            <li>
              <a href="#" class="dashboard-navbar-bell-icon" aria-label="Notifications" data-i18n-aria-label="dashboard.notifications"><i class="far fa-bell" aria-hidden="true"></i></a>
            </li>
            <li>
              <div class="dashboard-navbar-dropdown">
                <button
                  type="button"
                  id="dashboard-account-menu-button"
                  onclick="myFunction()"
                  class="dashboard-navbar-dropbtn"
                  aria-haspopup="menu"
                  aria-expanded="false"
                  aria-controls="dashboard-navbar-myDropdown"
                >
                  Lord Voldemort <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                
                <div id="dashboard-navbar-myDropdown" class="dashboard-navbar-dropdown-content">
                  <a href="#" style="font-size: 16px;" data-i18n="dashboard.profile">Profile</a>
                  <a href="/logout" style="font-size: 16px;" data-i18n="dashboard.logOut">Log Out</a>
                </div>
              </div>
            </li>
            <li>
              <a href="#" aria-label="User profile" data-i18n-aria-label="dashboard.userProfile"><i class="fa-regular fa-user dashboard-navbar-link-img dashboard-navbar-profile-icon" aria-hidden="true"></i></a>
            </li>
            
          </ul>
        </div>
      </nav>
    </div>
  </header>
</body>
<script>
const dashboardDropdownButton = document.getElementById("dashboard-account-menu-button");
const dashboardDropdownMenu = document.getElementById("dashboard-navbar-myDropdown");

function setDashboardDropdownState(isOpen) {
  if (!dashboardDropdownButton || !dashboardDropdownMenu) {
    return;
  }

  dashboardDropdownMenu.classList.toggle("dashboard-navbar-show", isOpen);
  dashboardDropdownButton.setAttribute("aria-expanded", String(isOpen));
}

function myFunction() {
  if (!dashboardDropdownMenu) {
    return;
  }

  const shouldOpen = !dashboardDropdownMenu.classList.contains("dashboard-navbar-show");
  setDashboardDropdownState(shouldOpen);
}

window.onclick = function(event) {
  if (!event.target.closest('.dashboard-navbar-dropdown')) {
    setDashboardDropdownState(false);
  }
}
</script>
</html>
