<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css"
    integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <title>Document</title>
  <link rel="stylesheet" href="../../../static/styles/partials/dashboard/dashboard-sidebar.css" />
  <link rel="stylesheet" href="../../../static/styles/main.css">


</head>

<body>
  <nav class="sidebar" aria-label="Dashboard navigation" data-i18n-aria-label="dashboard.sidebarNavigation">
    <div class="sidebar-container">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <img src="../../../static/assets/nav_logo.png" alt="" />
        </div>
        <div class="sidebar-title">Taskify</div>
        <a href="#" aria-label="Open dashboard navigation menu" data-i18n-aria-label="dashboard.sidebarToggle">
          <i class="menuIcon material-icons" aria-hidden="true">menu</i>
        </a>
      </div>
      <div class="sidebar-items">
        <ul class="menu">
          <li class="sidebar-list">
            <a href="#">
              <span class="sidebar-icon"><i class="fa-solid fa-house" aria-hidden="true"></i></span>
              <span class="sidebar-name" data-i18n="dashboard.sidebar.overview">Overview</span>
            </a>
          </li>

          <li class="sidebar-list">
            <a href="#">
              <span class="sidebar-icon">
                <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>
              </span>
              <span class="sidebar-name" data-i18n="dashboard.sidebar.stats">Stats</span>
            </a>
          </li>

          <li class="sidebar-list">
            <a href="#">
              <span class="sidebar-icon"><i class="fa-solid fa-folder-open" aria-hidden="true"></i></span>
              <span class="sidebar-name" data-i18n="dashboard.sidebar.projects">Projects</span>
            </a>
          </li>

          <li class="sidebar-list">
            <a href="#">
              <span class="sidebar-icon"><i class="fa-solid fa-comment" aria-hidden="true"></i></span>
              <span class="sidebar-name" data-i18n="dashboard.sidebar.chat">Chat</span>
            </a>
          </li>

          <li class="sidebar-list">
            <a href="#">
              <span class="sidebar-icon">
                <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
              </span>
              <span class="sidebar-name" data-i18n="dashboard.sidebar.calendar">Calendar</span>
            </a>
          </li>
          <div class="bottom-section">
            <li class="sidebar-list">
              <a href="#">
                <span class="sidebar-icon"><i class="fa-solid fa-gear" aria-hidden="true"></i></span>
                <span class="sidebar-name" data-i18n="dashboard.sidebar.settings">Settings</span>
              </a>
            </li>

            <li class="sidebar-list">
              <a href="#">
                <span class="sidebar-icon">
                  <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                </span>
                <span class="sidebar-name" data-i18n="dashboard.sidebar.logout">Log out</span>
              </a>
            </li>
          </div>
        </ul>
      </div>
    </div>
  </nav>
</body>
</html>
