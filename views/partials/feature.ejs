  <body>
    <section class="section feature-section">
      <div class="container feature-container">
          <div class="feature-main-heading">
              <h2 class="feature-secondary-heading" data-i18n="home.featureSectionTitle">Delightfully simple and deceptively powerful task
                   management</h2>
              <p data-i18n="home.featureSectionIntro">30 million+ people organize billions of tasks in Todoist for their work, education, and personal life.</p>
          </div>
          <div class="feature-even-column">
              <div class="feature-even-column-left">
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature1.webp" alt="">
                      <h3 class="feature-heading" data-i18n="home.featureCard1Title">With you everywhere</h3>
                      <p class="feature-text" data-i18n="home.featureCard1Body">Use Todoist’s apps, extensions and widgets on any device or platform.</p>
                      <a href="#" class="feature-btn feature-btn" data-i18n="home.featureCard1Cta">Download apps</a>
                  </div>
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature2.webp" alt="">
                      <h3 class="feature-heading" data-i18n="home.featureCard2Title">Make Todoist your</h3>
                      <p class="feature-text" data-i18n="home.featureCard2Body">Customize your to-do list with filters, labels, priorities, and more.</p>
                      <a href="#" class="feature-btn feature-btn" data-i18n="home.featureCard2Cta">See all features</a>
                  </div>
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature3.webp" alt="">
                      <h3 class="feature-heading" data-i18n="home.featureCard3Title">Productivity Method</h3>
                      <p class="feature-text" data-i18n="home.featureCard3Body">Personal productivity recommendations based on your unique traits and strengths.</p>
                      <a href="#" class="feature-btn feature-btn" data-i18n="home.featureCard3Cta">Take the quiz</a>
                  </div>
              </div>
              <div class="feature-even-column-right">
                  <div class="feature-features">
                      <img class="feature-img" src="../../static/assets/feature4.webp" alt="">
